{
  "name": "@elegram/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./limits": "./src/lib/limits.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "concurrently \"bun run test:unit\" \"bun run test:integration\"",
    "test:unit": "bun test --isolate --preload ./test/setup.ts test/unit",
    "test:integration": "bun test test/integration",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "db:migrate:dev": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "docker:build": "docker build --progress=plain -f Dockerfile -t elegram-server:local ../..",
    "docker:run": "docker run --rm -it --env-file .env.production -p 3000:3000 elegram-server:local",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:start": "docker compose -f docker-compose.dev.yml start",
    "docker:dev:stop": "docker compose -f docker-compose.dev.yml stop",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "docker:test:start": "docker compose -f docker-compose.test.yml start",
    "docker:test:stop": "docker compose -f docker-compose.test.yml stop"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.10",
    "@hono/zod-validator": "^0.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.10",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "prisma": "^7.8.0"
  }
}
