{
  "name": "elegram",
  "version": "0.0.1",
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.8.17",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "sh -ec 'trap \"bun run --cwd apps/server docker:dev:stop\" EXIT INT TERM; turbo dev --filter=@elegram/server --filter=@elegram/web'",
    "test": "sh -ec 'trap \"bun run --cwd apps/server docker:test:stop\" EXIT; turbo test --filter=@elegram/server --filter=@elegram/web'",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "ci:server": "act workflow_dispatch -W .github/workflows/ci-server.yml",
    "ci:web": "act workflow_dispatch -W .github/workflows/ci-web.yml",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
