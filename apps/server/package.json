{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:migrate:dev": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:start": "docker compose -f docker-compose.dev.yml start",
    "docker:dev:stop": "docker compose -f docker-compose.dev.yml stop",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "docker:test:start": "docker compose -f docker-compose.test.yml start",
    "docker:test:stop": "docker compose -f docker-compose.test.yml stop"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.10",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0"
  }
}