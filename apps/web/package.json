{
  "name": "@elegram/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "concurrently \"bun run test:dom\" \"bun run test:e2e\"",
    "test:dom": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "doctor": "bunx react-doctor",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "docker:build": "docker build --progress=plain -f Dockerfile -t elegram-web:local ../..",
    "docker:run": "docker run --rm -it -p 8080:80 -e PORT=80 elegram-web:local"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.10",
    "@tanstack/react-query": "^5.100.10",
    "@elegram/server": "workspace:*",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-form-devtools": "^0.2.27",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.6.10",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/eslint-plugin-query": "^5.100.11",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/router-cli": "^1.166.43",
    "@tanstack/router-plugin": "^1.167.35",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "react-doctor": "^0.1.6",
    "react-grab": "^0.1.34",
    "react-scan": "^0.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
